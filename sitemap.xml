layout: 
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
    xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  {% for page in site.pages %}
  {% if page.url contains '.xml' or page.url contains '.json' or page.url contains '.txt' or page.url contains 'assets' or page.url == '/404' or page.url == '/404.html' %}
  {% else %}
    <url>
        <loc>{{ page.url | absolute_url }}</loc>
        <changefreq>monthly</changefreq>
        <priority>1.0</priority>
    </url>
  {% endif %}
  {% endfor %}

  {% for page in site.projects %}
    <url>
        <loc>{{ page.url | replace: 'index.html', '' | absolute_url }}</loc>
        <changefreq>monthly</changefreq>
        <priority>1.0</priority>
    </url>
  {% endfor %}

  {% for post in site.posts %}
    <url>
        <loc>{{ post.url | absolute_url }}</loc>
        <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
  {% endfor %}

</urlset>

